# Keep the image lean and prevent leaking local secrets / scratch files.
# Previously this file didn't exist at all — the Dockerfile's `COPY . /app`
# had nothing stopping a stray local .env, __pycache__, or test DB from
# being baked into the image. Mirrors backend/django/.dockerignore.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage-python.xml
htmlcov/
*.log
*.sqlite3
db.sqlite3
_alembic_local.db

# Local env & virtualenvs — never bake secrets into an image.
.env
.env.*
!.env.*.example
.venv/
venv/
env/

# Editor / OS noise.
.DS_Store
.idea/
.vscode/
*.swp

# Git
.git/
.gitignore

# Docs do not belong in the runtime image.
*.md
docs/

# Test artifacts.
test_*.db
test_*.db.*
*.out
app/tests/
