# Nuxtron FastAPI production environment template
# Copy this file to your deployment secret manager and replace all placeholders.

# Runtime mode
ENVIRONMENT=production
SECURITY_STRICT_MODE=1
DEBUG=0

# API security
FASTAPI_API_KEY=replace-with-long-random-api-key
# Must be set to the IDENTICAL value as JWT_SIGNING_KEY in the Django
# service's environment (backend/django) — Django's FastAPIJWTAuthentication
# validates FastAPI-issued tokens with this same shared secret so a token
# minted by FastAPI's /auth/login also authenticates against Django. See
# backend/django/platform_api/authentication.py.
JWT_SIGNING_KEY=replace-with-long-random-jwt-signing-key
PASSWORD_PEPPER=replace-with-long-random-pepper
APP_ENC_KEY=replace-with-long-random-app-encryption-key

# Network hardening
ALLOWED_HOSTS=api.nuxtron.example.com
CORS_ORIGINS=https://app.nuxtron.example.com
# Set to 1 only if you explicitly need OpenAPI docs in production.
ENABLE_API_DOCS=0

# Database (required in production)
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=nuxtron
POSTGRES_USER=nuxtron
POSTGRES_PASSWORD=replace-with-strong-db-password

# Optional integrations
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# RAPIDAPI_KEY=
# TWITTER_BEARER_TOKEN=
# YOUTUBE_API_KEY=
# VAULT_ADDR=
# VAULT_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Core AI Brain (Model Layer)
# Reliability-first auto routing order: OpenAI -> Anthropic -> Google DeepMind -> LLaMA -> Mistral
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GOOGLE_VERTEX_API_KEY=
# GOOGLE_VERTEX_PROJECT_ID=
# GOOGLE_VERTEX_MODEL=gemini-2.0-flash
# GOOGLE_VERTEX_LOCATION=us-central1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLAMA_MODEL=llama3.2:3b
# OLLAMA_MISTRAL_MODEL=mistral:7b

# ─── IRA Autonomy Memory System ──────────────────────────────────────────────
# All values can be stored in Supabase Vault instead of plain env vars.
# See IRA_VAULT_SECRET_* names below; set them to the vault secret name you
# created with: SELECT vault.create_secret('value', 'name');

# Short-term memory – Redis
# REDIS_HOST=redis.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-redis-password
# REDIS_DB=0
# REDIS_URL=redis://:replace-with-redis-password@redis.internal:6379/0
# CELERY_WORKER_CONCURRENCY=4
# CELERY_QUEUES=analytics,seo,notifications
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# CELERY_WORKER_MAX_TASKS_PER_CHILD=100
# CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=786432
# CELERY_BROKER_POOL_LIMIT=20
# CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
# AI_TEXT_SOFT_TIME_LIMIT_SECONDS=45
# AI_TEXT_HARD_TIME_LIMIT_SECONDS=75
# AI_IMAGE_SOFT_TIME_LIMIT_SECONDS=120
# AI_IMAGE_HARD_TIME_LIMIT_SECONDS=180
# AI_VOICE_SOFT_TIME_LIMIT_SECONDS=240
# AI_VOICE_HARD_TIME_LIMIT_SECONDS=360
# AI_VIDEO_SOFT_TIME_LIMIT_SECONDS=600
# AI_VIDEO_HARD_TIME_LIMIT_SECONDS=900
# IRA_MEMORY_REDIS_PREFIX=ira:memory
# IRA_SHORT_TERM_MEMORY_LIMIT=40

# Supabase Vault secret names (looked up before env vars)
# IRA_VAULT_SECRET_REDIS_HOST=IRA_REDIS_HOST
# IRA_VAULT_SECRET_REDIS_PASSWORD=IRA_REDIS_PASSWORD
# IRA_VAULT_SECRET_PINECONE_API_KEY=IRA_PINECONE_API_KEY
# IRA_VAULT_SECRET_WEAVIATE_API_KEY=IRA_WEAVIATE_API_KEY

# Long-term vector memory – Supabase Postgres (preferred, tables auto-created)
# SUPABASE_DB_URL=postgresql://user:pass@host:5432/db

# External vector stores (optional – only needed without Supabase Postgres)
# PINECONE_API_KEY=replace-with-pinecone-key
# PINECONE_INDEX_HOST=replace-with-index-host
# PINECONE_NAMESPACE=ira-memory
# WEAVIATE_URL=https://your-cluster.weaviate.network
# WEAVIATE_API_KEY=replace-with-weaviate-key
# WEAVIATE_CLASS_NAME=IraMemoryChunk
# ──────────────────────────────────────────────────────────────────────────────

# IRA Agent Framework (Autonomy Layer)
# Framework auto-selection order: langchain -> semantic_kernel -> native_secure_loop
# Optional global default for auto mode: langchain | semantic_kernel | native_secure_loop
# IRA_AGENT_AUTO_FRAMEWORK=langchain
# Enable tenant preference override stored in IRA structured memory (1=true, 0=false)
# IRA_AGENT_PREFER_TENANT_MEMORY=1
# CrewAI is enabled only when both flags are set to 1.
# IRA_ENABLE_CREWAI=0
# IRA_CREWAI_SECURE_MODE=0

# Social Workspace Strict Production (required for 100% strict social readiness)
SOCIAL_OAUTH_MODE=live
SOCIAL_STRICT_NO_FALLBACK=1
# SOCIAL_AI_POLICY_JSON={"max_tokens":700,"temperature":0.5,"allow_actions":["rephrase","shorten","expand","casual","formal","generate","repurpose"],"blocked_keywords":["self-harm","hate","violence","terrorism","sexual minors"]}
# SOCIAL_AI_POLICY_PATH=/run/secrets/social_ai_policy.json

# Global strict dependencies
# OPENAI_API_KEY=replace-with-openai-key
# SENTRY_DSN=replace-with-sentry-dsn
# Stripe Billing: store these in your deployment secret manager. Prefer a
# restricted key (rk_live_) with Checkout, Customers, Subscriptions, Prices,
# and Billing Portal permissions. Never expose it to the frontend.
STRIPE_SECRET_KEY=rk_live_replace-with-restricted-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-endpoint-secret
SITE_URL=https://app.nuxtron.example.com
STRIPE_PRICE_PRO_MONTHLY=price_replace
STRIPE_PRICE_PRO_ANNUAL=price_replace
STRIPE_PRICE_STUDIO_MONTHLY=price_replace
STRIPE_PRICE_STUDIO_ANNUAL=price_replace
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_replace
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_replace
# Optional compatibility endpoint for non-subscription products. Comma-separated
# Stripe Price IDs only; leave empty when all purchases use Billing endpoints.
STRIPE_ALLOWED_ONE_TIME_PRICE_IDS=
# CANVA_ACCESS_TOKEN=replace-with-canva-token
# HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-token
# BITLY_ACCESS_TOKEN=replace-with-bitly-token
# TINYURL_API_TOKEN=replace-with-tinyurl-token
# REBRANDLY_API_KEY=replace-with-rebrandly-key

# OAuth providers and channel credentials
# SOCIAL_OAUTH_DISCORD_CLIENT_ID=replace-with-discord-client-id
# DISCORD_BOT_TOKEN=replace-with-discord-bot-token
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
# AZURE_AD_CLIENT_ID=replace-with-azure-ad-client-id
# OKTA_CLIENT_ID=replace-with-okta-client-id
# GITLAB_CLIENT_ID=replace-with-gitlab-client-id
# GITHUB_APP_ID=replace-with-github-app-id
# WEBHOOK_GITHUB_SECRET=replace-with-github-webhook-secret
# OUTLOOK_CLIENT_ID=replace-with-outlook-client-id
# GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-calendar-client-id

# Integration webhooks and automation bus
# SOCIAL_WEBHOOK_SECRET=replace-with-webhook-shared-secret
# ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxx/xxxx
# MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxx
