# Keep the image lean and prevent leaking local secrets / scratch files.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.log
*.sqlite3
db.sqlite3

# Local env & virtualenvs — never bake secrets into an image.
.env
.env.*
!.env.example
.venv/
venv/
env/

# Editor / OS noise.
.DS_Store
.idea/
.vscode/
*.swp

# Git
.git/
.gitignore

# Docs / reports do not belong in the runtime image.
*.md
docs/
reports/
*.json
!package.json

# Test artifacts (mirrors the messy repo root so stray DBs don't slip in).
test_*.db
test_*.db.*
*.out
