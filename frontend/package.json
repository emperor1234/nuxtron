{
  "name": "nuxtron-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 4173",
    "dev:watchdog": "node scripts/dev-watchdog.mjs",
    "prebuild": "node -e \"require('@builder.io/partytown/utils').copyLibFiles('public/~partytown').catch(()=>{})\"",
    "build": "next build --webpack",
    "start": "next start -p 4173",
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:smoke": "playwright test --config=./playwright.config.ts",
    "test:smoke:ci": "playwright test --config=./playwright.config.ts",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --coverage",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:smoke:headed": "playwright test --config=./playwright.config.ts --headed",
    "test:deep": "playwright test --config=./playwright.config.ts tests/smoke/deep.spec.ts tests/smoke/deep-social.spec.ts tests/smoke/deep-reviews.spec.ts tests/smoke/deep-notifications.spec.ts tests/smoke/deep-auth-tenants.spec.ts tests/smoke/deep-vse.spec.ts",
    "test:deep:headed": "playwright test --config=./playwright.config.ts tests/smoke/deep.spec.ts tests/smoke/deep-social.spec.ts tests/smoke/deep-reviews.spec.ts tests/smoke/deep-notifications.spec.ts tests/smoke/deep-auth-tenants.spec.ts tests/smoke/deep-vse.spec.ts --headed"
  },
  "dependencies": {
    "@builder.io/partytown": "0.10.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.5.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-boundaries": "^5.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "postcss": "8.5.26"
  }
}
