# ── Nuxtron Frontend — Coolify / production environment variables ───────────
#
# Set these as environment variables on the Coolify application (not as
# build args, except where noted) — Application → Environment Variables.
# Never commit the real values; this file documents names and meaning only.
#
# This list was generated by grepping every process.env.* read in the
# codebase (app/, proxy.ts, next.config.ts) — it is not a guess. Vars that
# appeared in older docs/examples but are no longer read anywhere
# (NEXT_PUBLIC_API_BASE, PostHog, GrowthBook, Vercel Analytics) are
# intentionally omitted; add them back only once that integration is
# actually wired up in code.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — server-only secrets
# Never prefix these with NEXT_PUBLIC_ — that bakes them into the client JS
# bundle, where any visitor can read them (see app/api/fastapi/[...path]/
# route.ts and app/lib/auth/jwt-edge.ts for why this matters).
# ─────────────────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend this proxy forwards to. No trailing slash.
FASTAPI_URL=https://api.your-domain.com

# Shared service API key sent as X-API-Key to FASTAPI_URL. Must match the
# backend's configured key. Required — the proxy returns 500 without it.
FASTAPI_API_KEY=

# JWT signing/verification secret. Must be the EXACT same value as the
# backend's JWT_SIGNING_KEY (backend/fastapi/app/deps.py
# `_resolve_jwt_secret`) — both sides verify the same HS256-signed token,
# so a mismatch here silently rejects every session at the edge
# (proxy.ts) before a page is even rendered. Generate with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Must be the literal string "production" — flips several checks to their
# strict/fail-closed behavior (backend JWT secret fallback is disabled,
# app/api/fastapi/[...path]/route.ts's automatic offline-fallback masking
# is disabled by default). NODE_ENV=production is set automatically by
# `next start`/this Dockerfile, but ENVIRONMENT is checked independently in
# app/lib/auth/jwt-edge.ts — set both.
ENVIRONMENT=production

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — public (safe to expose; also needed at DOCKER BUILD TIME as
# --build-arg, since Next.js inlines NEXT_PUBLIC_* values into the client
# bundle at build, not at container start)
# ─────────────────────────────────────────────────────────────────────────

# Default tenant slug sent as X-Tenant-Id when no session/tenant header is
# present. Set to your real default tenant, not "demo", in production.
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# Canonical site URL — used to build absolute URLs in app/sitemap.ts and
# app/robots.ts. Must be the real public URL Coolify serves this app on.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL — leave unset unless you specifically need the behavior
# ─────────────────────────────────────────────────────────────────────────

# Microsoft Clarity analytics project ID (app/layout.tsx). Omit to disable.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# When true, the SEO performance-audit route (seo-platform/performance/audit)
# refuses to serve anything but live, provider-backed data — mirrored
# server-side by SEO_STRICT_NO_MOCK below. Leave unset unless you have SEO
# provider credentials configured on the backend.
NEXT_PUBLIC_STRICT_NO_MOCK=
SEO_STRICT_NO_MOCK=

# Must NEVER be "true" in production — disables the server-side session
# gate in proxy.ts entirely (falls back to the old client-only guard). It
# exists solely so the Playwright smoke suite can navigate straight to
# protected routes without logging in first (see playwright.config.ts).
NEXT_PUBLIC_DISABLE_AUTH_GUARD=

# Caps how much of a request body app/api/fastapi/[...path]/route.ts will
# buffer into memory before forwarding upstream. Defaults to 10485760
# (10 MiB) if unset or non-numeric — only set this to raise or lower that
# limit (e.g. for larger media uploads through social scheduling).
NUXTRON_MAX_REQUEST_BODY_BYTES=

# Opt-in only: allows the proxy to serve fabricated 200 responses when the
# FastAPI backend is unreachable or 5xx-ing, instead of surfacing a real
# error. OFF by default in production on purpose — outages should be
# visible to monitoring, not hidden behind fake success responses. Only set
# to "true" if you deliberately want degraded-mode UX for a specific
# deployment and understand the tradeoff.
NUXTRON_AUTO_FALLBACK=

# Test/dev-only escape hatches for the offline-fallback system — do not set
# these in a real deployment; they exist for local development without a
# running backend.
# NUXTRON_PROXY_FORCE_FALLBACK=
# NUXTRON_PROXY_FORCE_FALLBACK_ROUTES=
# FASTAPI_FORCE_FALLBACK=
