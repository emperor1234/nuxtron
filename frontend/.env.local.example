# ── Nuxtron Frontend — environment variables ─────────────────────────────────
# Copy to .env.local for local dev. Never commit .env.local.
# On Vercel: set these in Project → Settings → Environment Variables.

# FastAPI backend URL (local dev uses the proxy in vercel.json/next.config)
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Public PostHog analytics (safe to expose — it's a public write-only key)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Vercel Analytics & Speed Insights (auto-injected by Vercel; set manually for self-hosted)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Feature flags (GrowthBook public SDK key)
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Tenant / organisation slug used as the default X-Tenant-Id header
NEXT_PUBLIC_DEFAULT_TENANT_ID=demo

# ── Server-only secrets ───────────────────────────────────────────────────
# These must NEVER use a NEXT_PUBLIC_ prefix — that bakes them into the
# client JS bundle where any visitor can read them. Only app/api/fastapi/
# route handlers (server-side) may read these.
FASTAPI_URL=http://localhost:8001
FASTAPI_API_KEY=

# JWT signing/verification secret used by proxy.ts to validate session
# tokens server-side before a protected page is ever rendered. Must be the
# exact same value as the backend's JWT_SIGNING_KEY
# (backend/fastapi/app/deps.py `_resolve_jwt_secret`) — both sides verify
# the same HS256-signed token, so a mismatch here means every session gets
# rejected. In non-production the backend also falls back to
# FASTAPI_API_KEY if this is unset; app/lib/auth/jwt-edge.ts mirrors that
# same fallback so local dev works without setting a second secret.
JWT_SIGNING_KEY=
